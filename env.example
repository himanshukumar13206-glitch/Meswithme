# === Telegram App (my.telegram.org) ===
API_ID=123456
API_HASH=your_api_hash_here

# === Bot ===
BOT_TOKEN=123456:ABC-your-bot-token
OWNER_ID=123456789          # your Telegram user id

# === Assistant account (userbot that actually joins the VC) ===
# Get this by running a session-string generator once (see README)
SESSION_STRING=your_pyrogram_session_string_here

# === MongoDB ===
MONGO_DB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=meow_music

# === Logger group (bot must be admin here) ===
LOGGER_GROUP_ID=-1001234567890

# === Misc ===
DURATION_LIMIT_MIN=60       # max song length allowed, minutes
AUTO_LEAVE_MIN=5            # leave VC if idle for N minutes

# === /start branding ===
START_IMG_URL=https://example.com/your-start-image.jpg
SUPPORT_CHANNEL=https://t.me/your_channel
SUPPORT_GROUP=https://t.me/your_support_group
# Must be https, and registered with @BotFather (/newapp) before the
# "Open App" button will actually work. Leave blank to hide that button.
MINI_APP_URL=
